# ==============================================================================
# Sanchari Backend Environment Configuration
# ==============================================================================

# Server Network & Environment
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017/sanchari

# Firebase Admin SDK Configuration
# Option 1: Direct credentials
FIREBASE_PROJECT_ID=sanchari-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-placeholder@sanchari-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC6example\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://sanchari-dev.firebaseio.com

# Option 2: Service Account JSON path (alternative)
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Google APIs & AI Services
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
